{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "nginx",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_directive"
      }
    },
    "_directive": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "directive_block_lua"
        },
        {
          "type": "SYMBOL",
          "name": "directive_geoip2"
        },
        {
          "type": "SYMBOL",
          "name": "directive_map"
        },
        {
          "type": "SYMBOL",
          "name": "directive_if"
        },
        {
          "type": "SYMBOL",
          "name": "directive_types"
        },
        {
          "type": "SYMBOL",
          "name": "directive_generic"
        }
      ]
    },
    "directive_generic": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "string_unquote"
          },
          "named": true,
          "value": "keyword"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_directive_args"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_block_directive"
              },
              "named": true,
              "value": "block"
            },
            {
              "type": "SYMBOL",
              "name": "terminator"
            }
          ]
        }
      ]
    },
    "_block_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_directive"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "_directive_args": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "SYMBOL",
          "name": "directive_arg"
        }
      }
    },
    "directive_arg": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "value_boolean"
        },
        {
          "type": "SYMBOL",
          "name": "value_size"
        },
        {
          "type": "SYMBOL",
          "name": "value_time"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        }
      ]
    },
    "directive_map": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "map"
          },
          "named": true,
          "value": "keyword"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "var"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_block_map"
          },
          "named": true,
          "value": "block"
        }
      ]
    },
    "_block_map": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "map_option"
              },
              {
                "type": "SYMBOL",
                "name": "map_entry"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "map_entry": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "string"
          },
          "named": true,
          "value": "map_key"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "string"
          },
          "named": true,
          "value": "map_value"
        },
        {
          "type": "SYMBOL",
          "name": "terminator"
        }
      ]
    },
    "map_option": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "STRING",
                "value": "default"
              },
              "named": true,
              "value": "keyword"
            },
            {
              "type": "SYMBOL",
              "name": "string"
            },
            {
              "type": "SYMBOL",
              "name": "terminator"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "STRING",
                "value": "include"
              },
              "named": true,
              "value": "keyword"
            },
            {
              "type": "SYMBOL",
              "name": "string"
            },
            {
              "type": "SYMBOL",
              "name": "terminator"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "STRING",
                "value": "hostnames"
              },
              "named": true,
              "value": "keyword"
            },
            {
              "type": "SYMBOL",
              "name": "terminator"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "STRING",
                "value": "volatile"
              },
              "named": true,
              "value": "keyword"
            },
            {
              "type": "SYMBOL",
              "name": "terminator"
            }
          ]
        }
      ]
    },
    "directive_types": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "types"
          },
          "named": true,
          "value": "keyword"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_block_types"
          },
          "named": true,
          "value": "block"
        }
      ]
    },
    "_block_types": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "types_entry"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "types_entry": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "mime_type"
          },
          "named": true,
          "value": "type_mime"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "type_ext"
          }
        },
        {
          "type": "SYMBOL",
          "name": "terminator"
        }
      ]
    },
    "type_ext": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-z0-9]+"
      }
    },
    "directive_if": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "if"
          },
          "named": true,
          "value": "keyword"
        },
        {
          "type": "SYMBOL",
          "name": "if_condition"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_block_directive"
          },
          "named": true,
          "value": "block"
        }
      ]
    },
    "if_condition": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "var"
            },
            {
              "type": "SYMBOL",
              "name": "_if_test"
            },
            {
              "type": "SYMBOL",
              "name": "_if_compare"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "_if_test": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "if_operator_test"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "if_string"
          },
          "named": true,
          "value": "string"
        }
      ]
    },
    "_if_compare": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "var"
        },
        {
          "type": "SYMBOL",
          "name": "if_operator_compare"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "if_string"
          },
          "named": true,
          "value": "string"
        }
      ]
    },
    "if_string": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string_dquote"
        },
        {
          "type": "SYMBOL",
          "name": "string_squote"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "if_string_unquote"
          },
          "named": true,
          "value": "string_unquote"
        }
      ]
    },
    "if_string_unquote": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\s(){};]+"
        }
      }
    },
    "directive_block_lua": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "STRING",
                "value": "set_by_lua_block"
              },
              "named": true,
              "value": "keyword"
            },
            {
              "type": "SYMBOL",
              "name": "var"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_block_lua"
              },
              "named": true,
              "value": "block"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "PATTERN",
                "value": "\\w+_by_lua_block"
              },
              "named": true,
              "value": "keyword"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_block_lua"
              },
              "named": true,
              "value": "block"
            }
          ]
        }
      ]
    },
    "_block_lua": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "_block_lua_content"
            }
          },
          "named": true,
          "value": "lua_code"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "_block_lua_content": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^\\{\\}]+"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "{"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_block_lua_content"
                  }
                },
                {
                  "type": "STRING",
                  "value": "}"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "directive_geoip2": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "geoip2"
          },
          "named": true,
          "value": "keyword"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "block_geoip2_entries"
          },
          "named": true,
          "value": "block"
        }
      ]
    },
    "block_geoip2_entries": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "geoip2_entry"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "geoip2_entry": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_geoip2_entry_setting"
        },
        {
          "type": "SYMBOL",
          "name": "_geoip2_entry_var"
        }
      ]
    },
    "_geoip2_entry_setting": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "auto_reload"
          },
          "named": true,
          "value": "keyword"
        },
        {
          "type": "SYMBOL",
          "name": "value_time"
        },
        {
          "type": "SYMBOL",
          "name": "terminator"
        }
      ]
    },
    "_geoip2_entry_var": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "var"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "string"
          }
        },
        {
          "type": "SYMBOL",
          "name": "terminator"
        }
      ]
    },
    "string": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string_dquote"
        },
        {
          "type": "SYMBOL",
          "name": "string_squote"
        },
        {
          "type": "SYMBOL",
          "name": "string_unquote"
        }
      ]
    },
    "comment": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "TOKEN",
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "#"
            },
            {
              "type": "PATTERN",
              "value": ".*"
            }
          ]
        }
      }
    },
    "random_value": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^;\\s]*"
        }
      }
    },
    "terminator": {
      "type": "STRING",
      "value": ";"
    },
    "keyword": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\w+"
      }
    },
    "var": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "$"
          },
          {
            "type": "PATTERN",
            "value": "\\w+"
          }
        ]
      }
    },
    "ident": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-zA-Z]\\w*"
      }
    },
    "string_dquote": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "PATTERN",
              "value": "[^\"]|(\\\\\\\")"
            }
          },
          {
            "type": "STRING",
            "value": "\""
          }
        ]
      }
    },
    "string_squote": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "'"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "PATTERN",
              "value": "[^']|(\\\\\\')"
            }
          },
          {
            "type": "STRING",
            "value": "'"
          }
        ]
      }
    },
    "string_unquote": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\s\\{\\};]+"
        }
      }
    },
    "value_boolean": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "on"
        },
        {
          "type": "STRING",
          "value": "off"
        }
      ]
    },
    "value_size": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "\\d+"
          },
          {
            "type": "PATTERN",
            "value": "[mkgMKG]"
          }
        ]
      }
    },
    "value_time": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "TOKEN",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "PATTERN",
                "value": "\\d+"
              },
              {
                "type": "PATTERN",
                "value": "(ms|s|m|h|d|w|M|y)"
              }
            ]
          }
        }
      }
    },
    "mime_type": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "application"
            },
            {
              "type": "STRING",
              "value": "audio"
            },
            {
              "type": "STRING",
              "value": "example"
            },
            {
              "type": "STRING",
              "value": "font"
            },
            {
              "type": "STRING",
              "value": "haptics"
            },
            {
              "type": "STRING",
              "value": "image"
            },
            {
              "type": "STRING",
              "value": "message"
            },
            {
              "type": "STRING",
              "value": "model"
            },
            {
              "type": "STRING",
              "value": "multipart"
            },
            {
              "type": "STRING",
              "value": "text"
            },
            {
              "type": "STRING",
              "value": "video"
            }
          ]
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "/"
          }
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "PATTERN",
            "value": "[A-Za-z0-9.+-]+"
          }
        }
      ]
    },
    "if_operator_test": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "-f"
        },
        {
          "type": "STRING",
          "value": "!-f"
        },
        {
          "type": "STRING",
          "value": "-d"
        },
        {
          "type": "STRING",
          "value": "!-d"
        },
        {
          "type": "STRING",
          "value": "-e"
        },
        {
          "type": "STRING",
          "value": "!-e"
        },
        {
          "type": "STRING",
          "value": "-x"
        },
        {
          "type": "STRING",
          "value": "!-x"
        }
      ]
    },
    "if_operator_compare": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "STRING",
          "value": "!="
        },
        {
          "type": "STRING",
          "value": "~"
        },
        {
          "type": "STRING",
          "value": "!~"
        },
        {
          "type": "STRING",
          "value": "~*"
        },
        {
          "type": "STRING",
          "value": "!~*"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}